{
  "name": "@vent0s/dsh-mod-workspace-files",
  "version": "0.4.0",
  "description": "DSH-Mod: repository status, verified Kimi and GLM setup, workspace shortcuts, and remote-access gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vent0s/DSH-Mod.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/gateway.js",
    "lib/diagnostics.js",
    "lib/client.js",
    "cordis.patch.yml",
    "src/index.d.ts",
    "src/client.d.ts",
    "README.md",
    "LICENSE",
    "lib/providers.js",
    "docs/upstream-review-2026-09-21.md",
    "docs/upstream-review-2026-10-18.md",
    "lib/provider-manager.js",
    "lib/repo-status.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:harness": "node --test tests/harness-providers.smoke.js",
    "test:client": "node --test tests/*-ui.smoke.js",
    "test:repos-browser": "node --test tests/repos-browser.smoke.js"
  },
  "license": "MIT"
}
